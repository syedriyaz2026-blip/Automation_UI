# Copy to a secure UAT environment; never commit real credentials.
ESI_ENV=uat
ESI_API_BASE_URL=https://uat.example.invalid
ESI_API_TIMEOUT_SECONDS=15
ESI_API_TOKEN=
ESI_GROUP_ROUTE=/api/groups
ESI_COMPANY_ROUTE=/api/groups/{group_id}/companies
ESI_DEPUTED_COMPANY_ROUTE=/api/companies/{company_id}/deputed-companies
ESI_ONBOARDED_EMPLOYEE_ROUTE=/api/companies/{company_id}/deputed-companies/{deputed_company_id}/employees/onboarded
ESI_SQL_SERVER=10.0.2.20
ESI_SQL_DATABASE=Emanage_statutory
ESI_SQL_READONLY=true
