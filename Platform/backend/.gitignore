# Python and test caches
__pycache__/
*.py[cod]
.pytest_cache/
.deepeval/
config/source_data.env

# Frontend dependencies and build output
node_modules/
desktop/node_modules/
desktop/dist/

# Local runtime stores (the application creates these as needed)
api_inbox/*
!api_inbox/.gitkeep
api_runs/*
!api_runs/.gitkeep
blob_storage/*
!blob_storage/.gitkeep

# Generated QA evidence and local logs
reports/qa/*
!reports/qa/.gitkeep
*.log

# Backend-only disposable caches
_cache_*/
.pytest_cache/
.deepeval/
__pycache__/
