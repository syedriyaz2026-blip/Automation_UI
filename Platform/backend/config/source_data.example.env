# Copy these names into the service environment. Do not commit real values.
# This connection is used only by SELECT statements in source_data.py.
PF_READONLY_DB_CONNECTION=DRIVER={ODBC Driver 18 for SQL Server};SERVER=your-server;DATABASE=your-database;UID=read-only-user;PWD=your-password;TrustServerCertificate=yes;ApplicationIntent=ReadOnly

# Optional source API from the supplied emanageadminapi-netcore service.
EMANAGE_API_BASE_URL=https://your-emanage-api.example
EMANAGE_API_TOKEN=
EMANAGE_API_KEY=
EMANAGE_API_USER_ID=
EMANAGE_CONTEXT_COMPANY_ID=
EMANAGE_CONTEXT_COMPANY_CODE=
EMANAGE_API_TIMEOUT_SECONDS=20

# Required for the independent ESI source adapter. Keep this endpoint separate
# from the PF employee endpoint; ESI source rows use the ESIC employee contract.
EMANAGE_ESI_EMPLOYEE_ROUTE=
EMANAGE_ESI_EMPLOYEE_METHOD=POST
ESI_RECENT_JOINING_ONLY=true
ESI_JOINING_WINDOW_HOURS=48

# Optional ESI worker boundary. No PF worker is used for ESI records.
# The worker must preserve the human CAPTCHA checkpoint.
ESI_AUTOMATION_COMMAND=
ESI_AUTOMATION_MODULE_PATH=
